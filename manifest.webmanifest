{
  "name": "BM Free Music",
  "short_name": "BM Music",
  "description": "聚合多平台音源、Google 设计语言、亮暗双主题的网络音乐播放器",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f8fafd",
  "theme_color": "#0b57d0",
  "lang": "zh-CN",
  "dir": "ltr",
  "categories": ["music", "entertainment"],
  "icons": [
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "搜索音乐",
      "url": "./index.html#/search",
      "description": "跨平台搜索歌曲",
      "icons": [{ "src": "./assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "歌单迁移",
      "url": "./index.html#/transfer",
      "description": "把外部歌单搬到本地",
      "icons": [{ "src": "./assets/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
