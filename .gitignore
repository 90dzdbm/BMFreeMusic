# ---------- 构建环境（体积大，重新构建时自动下载） ----------
.buildenv/

# ---------- 构建中间产物 ----------
android/build/
# 构建时由 build-apk.sh 从根目录复制过来，不入库
android/assets/

# ---------- 二进制产物：走 GitHub Releases 分发，不进仓库 ----------
*.apk
*.aab
*.idsig
Releases/*.apk
Releases/*.zip

# ---------- 签名密钥 ----------
# bmfm.keystore 必须入库！这是「新包盖不住旧包」的根本原因：
# 密钥没入库，别人（或换一台机器）重新构建会生成一把新密钥，
# 签名对不上，系统就只允许卸载后重装。
# 风险是别人能用同一把密钥伪造更新包 —— 但项目是公开开源的，
# 密钥必须共享才能让任何人构建出可覆盖安装的包。
*.keystore
*.jks
!android/bmfm.keystore

# ---------- 本地临时 ----------
_shot/
node_modules/
*.log
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本地笔记 ----------
新版本改进建议.txt
*.local.txt
